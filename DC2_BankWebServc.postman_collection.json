{
  "info": {
    "name": "DC2 Bank Web Service (Part A)",
    "description": "Tests for the DataWebAPI. Start the API first (dotnet run --project DataWebAPI, runs on http://localhost:5122), then run the folders top to bottom. Requests that create a user / account save its id so the later requests can use it. Seeded logins: admin / Admin@123, customer / Customer@123, every other seeded user / Password@123.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5122" },
    { "key": "userId", "value": "" },
    { "key": "username", "value": "" },
    { "key": "accountNumber", "value": "" },
    { "key": "auditId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Login (admin, returns role)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
            "pm.test(\"role is Admin\", () => pm.expect(pm.response.json().role).to.eql(\"Admin\"));",
            "pm.test(\"no password hash\", () => pm.expect(pm.response.text()).to.not.include(\"passwordHash\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "Login wrong password (401)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"401 Unauthorized\", () => pm.response.to.have.status(401));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"customer\",\n  \"password\": \"wrong-password\"\n}" },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "Create user (201)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
            "pm.test(\"has Location header\", () => pm.response.to.have.header(\"Location\"));",
            "pm.collectionVariables.set(\"userId\", pm.response.json().userId);",
            "pm.collectionVariables.set(\"username\", pm.response.json().username);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"postman{{$timestamp}}\",\n  \"name\": \"Postman Tester\",\n  \"email\": \"postman{{$timestamp}}@example.com\",\n  \"password\": \"Tester@123\",\n  \"address\": \"1 Hay St, Perth WA 6000\",\n  \"phone\": \"0400 123 456\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create user duplicate username (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"name\": \"Someone Else\",\n  \"email\": \"someone{{$timestamp}}@example.com\",\n  \"password\": \"Tester@123\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Create user invalid fields (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
            "pm.test(\"error is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error).to.eql(\"VALIDATION_ERROR\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"bad name!\",\n  \"name\": \"\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"role\": \"Boss\"\n}" },
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get user by id",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Get user by username",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/username/olivia.smith" }
        },
        {
          "name": "Get user by email",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/email/customer@bank.local" }
        },
        {
          "name": "Get user not found (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/99999" }
        },
        {
          "name": "Search users",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users?search=smith&role=Customer&page=1&pageSize=10" }
        },
        {
          "name": "Update user (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Tester Updated\",\n  \"email\": \"updated{{$timestamp}}@example.com\",\n  \"address\": \"2 Murray St, Perth WA 6000\",\n  \"phone\": \"0400 654 321\"\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update user duplicate email (409)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"409 Conflict\", () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"admin@bank.local\"\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Reset password (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"newPassword\": \"NewTester@123\"\n}" },
            "url": "{{baseUrl}}/api/users/{{userId}}/password"
          }
        },
        {
          "name": "Login with new password",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"NewTester@123\"\n}" },
            "url": "{{baseUrl}}/api/users/login"
          }
        },
        {
          "name": "Upload profile picture",
          "description": "Pick a .jpg or .png file (max 2 MB) for the 'file' key in Body > form-data before sending.",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": {
            "method": "POST",
            "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": [] }] },
            "url": "{{baseUrl}}/api/users/{{userId}}/picture"
          }
        },
        {
          "name": "Get profile picture",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{userId}}/picture" }
        }
      ]
    },
    {
      "name": "Accounts",
      "item": [
        {
          "name": "Create account (201)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
            "pm.test(\"has Location header\", () => pm.response.to.have.header(\"Location\"));",
            "pm.collectionVariables.set(\"accountNumber\", pm.response.json().accountNumber);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": {{userId}},\n  \"accountType\": \"Savings\"\n}" },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Create account for missing user (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"userId\": 99999,\n  \"accountType\": \"Savings\"\n}" },
            "url": "{{baseUrl}}/api/accounts"
          }
        },
        {
          "name": "Get account",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts/{{accountNumber}}" }
        },
        {
          "name": "Get account not found (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts/0000" }
        },
        {
          "name": "Get accounts of a user",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/accounts?userId={{userId}}" }
        },
        {
          "name": "Update account (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountType\": \"Everyday\"\n}" },
            "url": "{{baseUrl}}/api/accounts/{{accountNumber}}"
          }
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "Deposit (201)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"201 Created\", () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": 500,\n  \"description\": \"Postman deposit\"\n}" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        },
        {
          "name": "Withdraw (201)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"201 Created\", () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": 100,\n  \"description\": \"Postman withdrawal\"\n}" },
            "url": "{{baseUrl}}/api/transactions/withdraw"
          }
        },
        {
          "name": "Withdraw more than balance (422)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"422 Unprocessable\", () => pm.response.to.have.status(422));",
            "pm.test(\"error is INSUFFICIENT_FUNDS\", () => pm.expect(pm.response.json().error).to.eql(\"INSUFFICIENT_FUNDS\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": 1000000\n}" },
            "url": "{{baseUrl}}/api/transactions/withdraw"
          }
        },
        {
          "name": "Transfer (201)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"201 Created\", () => pm.response.to.have.status(201));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountNumber\": \"{{accountNumber}}\",\n  \"toAccountNumber\": \"1001\",\n  \"amount\": 50,\n  \"description\": \"Postman transfer\"\n}" },
            "url": "{{baseUrl}}/api/transactions/transfer"
          }
        },
        {
          "name": "Transfer to same account (422)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"422 Unprocessable\", () => pm.response.to.have.status(422));",
            "pm.test(\"error is SAME_ACCOUNT\", () => pm.expect(pm.response.json().error).to.eql(\"SAME_ACCOUNT\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fromAccountNumber\": \"{{accountNumber}}\",\n  \"toAccountNumber\": \"{{accountNumber}}\",\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/transactions/transfer"
          }
        },
        {
          "name": "Deposit negative amount (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": -5\n}" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        },
        {
          "name": "Deposit to missing account (404)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"0000\",\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        },
        {
          "name": "Search transactions (paged, sorted)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/transactions?accountNumber=1001&page=1&pageSize=5&sortBy=amount&sortDir=desc" }
        },
        {
          "name": "Search transactions pageSize too big (400)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/transactions?pageSize=500" }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Create audit entry (201)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set(\"auditId\", pm.response.json().auditId);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"adminUserId\": 1,\n  \"action\": \"POSTMAN_TEST\",\n  \"targetType\": \"User\",\n  \"targetId\": \"{{userId}}\",\n  \"details\": \"Created from Postman\"\n}" },
            "url": "{{baseUrl}}/api/audit"
          }
        },
        {
          "name": "Get audit entry",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/audit/{{auditId}}" }
        },
        {
          "name": "Search audit log",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"200 OK\", () => pm.response.to.have.status(200));"] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/audit?page=1&pageSize=20" }
        }
      ]
    },
    {
      "name": "Deactivate",
      "item": [
        {
          "name": "Deactivate account (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/accounts/{{accountNumber}}" }
        },
        {
          "name": "Deposit to deactivated account (422)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"422 Unprocessable\", () => pm.response.to.have.status(422));",
            "pm.test(\"error is ACCOUNT_INACTIVE\", () => pm.expect(pm.response.json().error).to.eql(\"ACCOUNT_INACTIVE\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"accountNumber\": \"{{accountNumber}}\",\n  \"amount\": 10\n}" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        },
        {
          "name": "Deactivate user (204)",
          "event": [{ "listen": "test", "script": { "exec": ["pm.test(\"204 No Content\", () => pm.response.to.have.status(204));"] } }],
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/users/{{userId}}" }
        },
        {
          "name": "Login deactivated user (422)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"422 Unprocessable\", () => pm.response.to.have.status(422));",
            "pm.test(\"error is USER_INACTIVE\", () => pm.expect(pm.response.json().error).to.eql(\"USER_INACTIVE\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"NewTester@123\"\n}" },
            "url": "{{baseUrl}}/api/users/login"
          }
        }
      ]
    },
    {
      "name": "Errors",
      "item": [
        {
          "name": "Unknown URL (404)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
            "pm.test(\"error is NOT_FOUND\", () => pm.expect(pm.response.json().error).to.eql(\"NOT_FOUND\"));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/does-not-exist" }
        },
        {
          "name": "Malformed JSON (400)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
            "pm.test(\"error is VALIDATION_ERROR\", () => pm.expect(pm.response.json().error).to.eql(\"VALIDATION_ERROR\"));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"accountNumber\": \"1001\", \"amount\": }" },
            "url": "{{baseUrl}}/api/transactions/deposit"
          }
        }
      ]
    }
  ]
}
