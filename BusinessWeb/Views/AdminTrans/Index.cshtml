@model BankMvc.Controllers.AdminTransactionsViewModel
@{
    ViewData["Title"] = "All Transactions";

    // clicking the same column again flips asc/desc, clicking a new column starts with asc
    string NextDir(string col) =>
        Model.Query.SortBy == col && Model.Query.SortDir == "asc" ? "desc" : "asc";

    // little arrow shown next to the column that is currently sorted
    string Arrow(string col) =>
        Model.Query.SortBy == col ? (Model.Query.SortDir == "asc" ? " ▲" : " ▼") : "";

    // builds the link values for sort/paging links, keeps all the current filters (only the filled ones)
    Dictionary<string, string> Link(int page, string sortBy, string sortDir)
    {
        var d = new Dictionary<string, string>
        {
            ["Page"] = page.ToString(),
            ["PageSize"] = Model.Query.PageSize.ToString(),
            ["SortBy"] = sortBy,
            ["SortDir"] = sortDir
        };
        if (!string.IsNullOrWhiteSpace(Model.Query.AccountNumber)) d["AccountNumber"] = Model.Query.AccountNumber;
        if (!string.IsNullOrWhiteSpace(Model.Query.Search)) d["Search"] = Model.Query.Search;
        if (Model.Query.From.HasValue) d["From"] = Model.Query.From.Value.ToString("yyyy-MM-dd");
        if (Model.Query.To.HasValue) d["To"] = Model.Query.To.Value.ToString("yyyy-MM-dd");
        return d;
    }

    var dateSortLink = Link(1, "timestamp", NextDir("timestamp"));
    var amountSortLink = Link(1, "amount", NextDir("amount"));
}

<h2>All Transactions</h2>

@* filter form, GET so the filters stay in the url (easy to page and sort with them) *@
<form method="get" asp-action="Index" class="row g-2 my-3">
    <div class="col-auto">
        <label class="form-label">Account number</label>
        <input type="text" name="AccountNumber" value="@Model.Query.AccountNumber" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Search (type or account)</label>
        <input type="text" name="Search" value="@Model.Query.Search" class="form-control" placeholder="ex: Deposit" />
    </div>
    <div class="col-auto">
        <label class="form-label">From</label>
        <input type="date" name="From" value="@Model.Query.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">To</label>
        <input type="date" name="To" value="@Model.Query.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="col-auto">
        <label class="form-label">Per page</label>
        <select name="PageSize" class="form-select">
            @foreach (var size in new[] { 5, 10, 25, 50 })
            {
                <option value="@size" selected="@(Model.Query.PageSize == size)">@size</option>
            }
        </select>
    </div>

    @* keep the current sorting when filtering *@
    <input type="hidden" name="SortBy" value="@Model.Query.SortBy" />
    <input type="hidden" name="SortDir" value="@Model.Query.SortDir" />

    <div class="col-auto align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

@if (Model.Error != null)
{
    <div class="alert alert-danger">@Model.Error</div>
}
else if (Model.Result == null || !Model.Result.Items.Any())
{
    <div class="alert alert-info">No transactions found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                @* sortable column: date *@
                <th><a asp-action="Index" asp-all-route-data="dateSortLink">Date @Arrow("timestamp")</a></th>
                <th>Account</th>
                <th>Type</th>
                @* sortable column: amount *@
                <th class="text-end"><a asp-action="Index" asp-all-route-data="amountSortLink">Amount @Arrow("amount")</a></th>
                <th class="text-end">Balance after</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model.Result.Items)
            {
                <tr>
                    <td>@t.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@t.AccountNumber</td>
                    <td>@t.Type</td>
                    @* money in = green, money out = red *@
                    <td class="text-end @(t.Amount < 0 ? "text-danger" : "text-success")">@t.Amount.ToString("N2")</td>
                    <td class="text-end">@t.BalanceAfter.ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    @* paging: previous, 5 page numbers around the current page, next *@
    var page = Model.Result.Page;
    var last = Model.Result.TotalPages;
    var start = Math.Max(1, page - 2);
    var end = Math.Min(last, page + 2);
    var prevLink = Link(page - 1, Model.Query.SortBy, Model.Query.SortDir);
    var nextLink = Link(page + 1, Model.Query.SortBy, Model.Query.SortDir);
    
    <nav>
        <ul class="pagination">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="prevLink">Previous</a>
            </li>
            @for (var p = start; p <= end; p++)
            {
                var pageLink = Link(p, Model.Query.SortBy, Model.Query.SortDir);
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="pageLink">@p</a>
                </li>
            }
            <li class="page-item @(page >= last ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="nextLink">Next</a>
            </li>
        </ul>
    </nav>
    <p class="text-muted">Showing page @(page) of @last (@Model.Result.TotalCount transactions)</p>
}
