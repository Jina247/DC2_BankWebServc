@model BankMvc.Models.StatusViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="py-5 text-center">
    <div class="display-4 text-muted">@Model.Code</div>
    <h2>@Model.Title</h2>
    <p class="text-muted">@Model.Message</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
