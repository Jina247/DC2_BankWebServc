@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

@* friendly error page: no stack trace or raw error is ever shown to the user (it goes to the log instead) *@
<div class="py-5 text-center">
    <h2>Sorry, something went wrong.</h2>
    <p class="text-muted">We couldn't complete your request. Please try again in a moment.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Reference: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
</div>
